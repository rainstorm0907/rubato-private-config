#!/bin/zsh
# abrowse — run one deterministic browser step in the Aside REPL and let only a bounded
# amount of output cross back. The cap is the routing rule made structural: if a step
# produces more than it, you did not actually know what to extract, and it belongs in gbrowse.
#
#   abrowse 'console.log(await page.title())'
#   abrowse -m 8000 '...'    # raise the cap deliberately
#   abrowse -f step.js
#
# exit 0  output on stdout
# exit 3  aside account signed out
# exit 5  output exceeded the cap — nothing printed; use gbrowse instead
# exit 6  the REPL step itself errored

set -u
cap=4000; file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m) cap="$2"; shift 2 ;;
    -f) file="$2"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
code="${file:+$(<$file)}"; [[ -n "$code" ]] || code="$*"
[[ -n "$code" ]] || { echo "abrowse: code required" >&2; exit 64; }

aside account status 2>/dev/null | grep -q 'signed in' || {
  echo "abrowse: aside account is signed out" >&2; exit 3; }

raw=$(aside repl "$code" 2>&1)
# strip ANSI, then the CLI's own decoration, keeping only what the step printed
clean=$(print -r -- "$raw" | sed $'s/\033\[[0-9;]*m//g')
rstatus=$(print -r -- "$clean" | grep -o '^\[\(ok\|error\) |' | head -1)
body=$(print -r -- "$clean" | grep -v '^✔︎\|^\[ok |\|^\[error |')
bytes=$(print -r -- "$body" | wc -c | tr -d ' ')

if [[ "$rstatus" == "[error |" ]] || print -r -- "$body" | grep -qi '^[A-Za-z]*Error\|ERR:'; then
  echo "abrowse: step errored" >&2; print -r -- "$body" | head -c 600 >&2; echo >&2; exit 6
fi
if [[ "$bytes" -gt "$cap" ]]; then
  echo "abrowse: output ${bytes}B exceeds cap ${cap}B — this step is exploration, not extraction. Use: gbrowse \"<mission>\"" >&2
  exit 5
fi
print -r -- "$body"
